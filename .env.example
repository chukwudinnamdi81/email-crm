DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailcrm
REDIS_URL=redis://localhost:6379
# 32 bytes, base64 or 64 hex chars:  openssl rand -base64 32
ENCRYPTION_KEY=
# Secret used to sign unsubscribe tokens (openssl rand -base64 32)
SIGNING_SECRET=
APP_URL=http://localhost:3000
# web | worker (Docker image)
SERVICE=web
SYNC_CONCURRENCY=3
SYNC_INTERVAL_MINUTES=10
# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Email verification
VERIFY_FROM=verify@example.com
VERIFY_HELO=mail.example.com
# AI (optional server key; users can save their own)
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_DAILY_REQUEST_CAP=200
AI_DAILY_TOKEN_CAP=400000
# Allow private-IP SMTP hosts (dev only)
ALLOW_PRIVATE_HOSTS=false
# Google sign-in uses the same client as above; add BOTH redirect URIs under "Authorized redirect URIs":
#   ${APP_URL}/api/oauth/callback        (mailbox connect)
#   ${APP_URL}/api/auth/google/callback  (sign in with Google)
# Railway: SERVICE=web on the web service; DATABASE_URL / REDIS_URL referenced from the Railway plugins;
# APP_URL = public https URL; prefer SITE_MAIL_PROVIDERS=resend (outbound SMTP may be blocked on Railway).
# REDIS_TIMEOUT_MS=1500 caps how long rate-limit checks wait on Redis.
# Site emails (confirmation codes, password reset). Set on the WEB service. Providers tried in order.
SITE_MAIL_PROVIDERS=resend,postmark,smtp
SITE_MAIL_FROM="Mail CRM <no-reply@example.com>"
SITE_RESEND_API_KEY=
SITE_POSTMARK_TOKEN=
SITE_SMTP_HOST=
# port 25 is not tried unless listed; 465 = implicit TLS, others STARTTLS
SITE_SMTP_PORTS=587,465,2525
SITE_SMTP_USER=
SITE_SMTP_PASS=
# Per-provider send budgets. Defaults are conservative: set them to match your provider plan.
SITE_MAIL_MAX_PER_SECOND=2
SITE_MAIL_MAX_PER_HOUR=50
SITE_MAIL_MAX_PER_DAY=100
# Sign-up protection. SIGNUPS_ENABLED=false is the emergency brake (existing users can still log in).
SIGNUPS_ENABLED=true
SIGNUP_MAX_PER_HOUR=100
SIGNUP_MAX_PER_DAY=500
# Extra blocked / always-allowed email domains for NEW accounts (comma lists)
SITE_BLOCKED_DOMAINS=
SITE_ALLOWED_DOMAINS=
# Days before unconfirmed accounts are removed by the worker (default 7)
SITE_UNVERIFIED_TTL_DAYS=7
# Legal pages (/privacy, /terms)
# Name of the operator (fallback: Mail CRM)
LEGAL_ENTITY_NAME=
# Contact address shown on the legal pages (nothing is invented if unset)
LEGAL_CONTACT_EMAIL=
# Date shown as "Last updated" (YYYY-MM-DD)
LEGAL_EFFECTIVE_DATE=
# Governing law clause text, e.g. "the laws of England and Wales" (section omitted if unset)
LEGAL_GOVERNING_LAW=

# Sync fairness (worker). Max mailboxes of ONE user syncing at once (default 2)
SYNC_PER_USER_CONCURRENCY=2
# A long first sync yields its worker slot after this many seconds, but only if another job is waiting (default 240)
SYNC_SLICE_SECONDS=240
# Optional guard: refuse a first full sync (no sync window) of a mailbox with more messages than this. 0 = off (default)
SYNC_MAX_FULL_SYNC_MESSAGES=0
