{
  "name": "mail-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run check:storage",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "worker": "tsx worker/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma db push --skip-generate",
    "db:push": "prisma db push",
    "db:backfill": "tsx scripts/backfill-email-verified.ts",
    "check:storage": "tsx scripts/check-storage-registry.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "disposable-email-domains": "^1.0.62",
    "imapflow": "^1.0.171",
    "ioredis": "^5.4.2",
    "mailparser": "^3.7.2",
    "next": "^15.1.0",
    "nodemailer": "^6.9.16",
    "postcss": "^8.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sanitize-html": "^2.13.0",
    "prisma": "^6.0.0",
    "typescript": "^5.7.2"
  }
}
